{
  "name": "papercraft-kingdom-defense",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "prettier --check . && eslint . && tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:assets": "node scripts/check-assets.mjs",
    "check:sim-purity": "node scripts/check-sim-purity.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:render-boundary": "node scripts/check-render-boundary.mjs",
    "check:fixtures": "node scripts/check-fixtures.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
